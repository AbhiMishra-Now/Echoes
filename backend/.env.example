# AWS Configuration (App Runtime)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Deployment Credentials (Serverless Framework Deployer)
AWS_DEPLOY_ACCESS_KEY_ID=your_deployment_access_key_here
AWS_DEPLOY_SECRET_ACCESS_KEY=your_deployment_secret_key_here

# AWS Resources
# DYNAMODB_TABLE/S3_BUCKET are the preferred names. Legacy aliases remain supported.
DYNAMODB_TABLE=echoes_biographies
S3_BUCKET=echoes-media-bucket-your-initials

# Application Settings
API_V1_STR=/api/v1
PROJECT_NAME=Echoes Backend
DEBUG=True
BACKEND_CORS_ORIGINS=["*"]

# Security
# Required only when authentication is introduced; generate a unique value per environment.
SECRET_KEY=replace_with_a_long_random_secret

# Replicate AI Configuration
# Leave the token unset to use the safe no-token chat fallback locally.
REPLICATE_API_TOKEN=your_token_here
REPLICATE_MODEL=deepseek-ai/deepseek-r1
